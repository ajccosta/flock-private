class by_transaction_size(parameters) :
    file_suffix = bench_name
    lists = default_lists
    list_sizes = default_list_size
    trees = default_trees
    tree_sizes = default_tree_size
    zipfians = default_zipfian
    trans_sizes = [1,4,16,64,256]
    mix_percents = default_mix
    processors = default_threads
    suffixes_all = trans_suffixes
                    
run_all(by_transaction_size)

range_threads = round(maxcpus * .95)

class range_search(parameters) :
    file_suffix = bench_name
    trees = ["btree"]
    tree_sizes = default_tree_size
    zipfians = default_zipfian
    processors = default_threads
    mix_percents = [[100,0,range_threads,4], [100,0,range_threads,64], [100,0,range_threads,1024], [100,0,range_threads,16384]]
    suffixes_all = trans_suffixes

run_all(range_search)
